# Hasebtak (حسبتك) - Environment Configuration
# Free API Keys & Configuration

# Google Gemini API Key (Free Tier: 15 RPM / 1,500 req/day)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional free fallback LLM & Whisper STT)
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot Token (from @BotFather - 100% Free Forever)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# WhatsApp Cloud API / Twilio Sandbox (Optional for WhatsApp demo)
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=hasebtak_secret_verify_token

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
VOICE_GENDER=female
